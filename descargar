#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"

if [[ ! -x .venv/bin/python ]]; then
  python3 -m venv .venv
  .venv/bin/pip install -r requirements.txt
fi

if [[ ! -x .tools/deno ]]; then
  mkdir -p .tools
  tmp="$(mktemp)"
  curl -fsSL -o "$tmp" \
    https://github.com/denoland/deno/releases/latest/download/deno-x86_64-unknown-linux-gnu.zip
  python3 -m zipfile -e "$tmp" .tools
  chmod +x .tools/deno
  rm -f "$tmp"
fi

exec .venv/bin/python download.py "$@"
